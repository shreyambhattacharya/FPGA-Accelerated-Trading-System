// Sipeed Tang Nano 20K / GW2AR-LV18QN88C8/I7.
//
// External SPI signals use the exposed 3.3 V GPIO/header pins specified for
// this project. The LCD/FPC connector must remain disconnected while these
// shared FPGA pins are used for SPI.

// Onboard 27 MHz crystal. See Sipeed Tang Nano 20K official blink example.
IO_LOC "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33;

// Raspberry Pi SPI0 connection, mode 0, Pi is master.
IO_LOC "spi_mosi" 27;
IO_PORT "spi_mosi" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC "spi_miso" 28;
IO_PORT "spi_miso" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC "spi_clk" 25;
IO_PORT "spi_clk" IO_TYPE=LVCMOS33 PULL_MODE=NONE;

IO_LOC "spi_cs_n" 26;
IO_PORT "spi_cs_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

// Six onboard LEDs are active-low. LED0/1/2 are heartbeat/activity/error.
IO_LOC "led[0]" 15;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "led[1]" 16;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "led[2]" 17;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "led[3]" 18;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "led[4]" 19;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
IO_LOC "led[5]" 20;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 PULL_MODE=UP;
